# Copy to .env and protect it (chmod 600). Never commit .env.

# REQUIRED: obtain a bot token from BotFather. Never paste it into logs or URLs in tickets.
# Use the raw BotFather token, without a URL or an extra "bot" prefix.
TELEGRAM_BOT_TOKEN=
# REQUIRED: a positive private chat ID. The client cannot override this destination.
TELEGRAM_CHAT_ID=
# REQUIRED: generate with openssl rand -hex 32. Every writer shares this single-user credential.
API_KEY=

# OPTIONAL: the exact public DNS name used by your reverse proxy; wildcard hosts are rejected.
GATEWAY_HOST=gateway.example.invalid
# OPTIONAL: proxy's literal IP, only when forwarded client IP/protocol headers are needed.
# Blank keeps forwarded headers disabled. Never trust a public client IP or broad network.
TRUSTED_PROXY_IP=
# OPTIONAL: network name to share with Nginx Proxy Manager or cloudflared. Keep the old default.
GATEWAY_NETWORK=telegram-gateway
# Data volume. Blank = the name Compose has always used (<project>_gateway-data). After renaming the
# folder or the Portainer stack, set it to the existing name shown by `docker volume ls`, for example
# telegramgateway_gateway-data, or Compose creates a new, empty volume (INSTALL.md, "Renaming to AgentGateway").
GATEWAY_VOLUME_NAME=
# OPTIONAL: enables /mcp for clients that can provide X-Api-Key. It does not enable OAuth.
# Enabled MCP includes read-only delivery status queries by UUID for messages and digests.
ENABLE_MCP=false
ENABLE_MCP_OAUTH=false
MCP_PUBLIC_URL=https://gateway.example.invalid
# OAuth client 0 (ChatGPT): unchanged. Scope telegram:send.
MCP_OAUTH_CLIENT_ID=telegram-gateway
# Generate a separate 32+ character client secret; never commit the real value.
OAUTH_CLIENT_SECRET=
# Copy the exact HTTPS callback URI shown by your MCP client; wildcards are not accepted.
MCP_OAUTH_REDIRECT_URI=
# OAuth client 1 (optional): the claude.ai custom connector used by the news routine. Blank ID = no client 1.
# claude.ai uses https://claude.ai/api/mcp/auth_callback and may move to https://claude.com/api/mcp/auth_callback;
# register both. Generate the secret with openssl rand -hex 32 and enter ID + secret in the connector's
# advanced settings. Scope news:publish lets it use only the news tools.
MCP_OAUTH_CLIENT_1_ID=
OAUTH_CLIENT_1_SECRET=
MCP_OAUTH_CLIENT_1_REDIRECT_URI=https://claude.ai/api/mcp/auth_callback
MCP_OAUTH_CLIENT_1_REDIRECT_URI_2=https://claude.com/api/mcp/auth_callback
MCP_OAUTH_CLIENT_1_SCOPE=news:publish
# OPTIONAL: per connection IP; trusted proxy configuration is required for distinct external clients.
REQUEST_LIMIT_PER_MINUTE=30

# News module (publishes daily issues to the WordPress theme). Off until the credentials below are set.
NEWS_ENABLED=false
NEWS_WORDPRESS_BASE_URL=https://vahac.com
# The WordPress user with the role vahac_news_publisher (INSTALL.md, "WordPress Application Password").
NEWS_WORDPRESS_USER=
# Its Application Password (Users -> Profile -> Application Passwords). Secret; spaces are fine.
WORDPRESS_APP_PASSWORD=
# One Telegram line with the day page link after each published issue.
NEWS_NOTIFY_TELEGRAM=true
# With NEWS_ENABLED=true two more parts run by default, without any setting here (README, "News feeds" and
# "News watchdog"): the feed collector reads the publishers' RSS/Atom feeds of the shipped catalog once an hour
# for the routine's get_news_feed tool, and the watchdog sends one Telegram alert when no issue arrived by
# 06:00 UTC. To change or switch them off, add to the gateway's environment: in Compose, for example:
#   AGENTGATEWAY_News__FeedsEnabled: "false"        (no feed requests; the feed tools answer with an error)
#   AGENTGATEWAY_News__WatchdogEnabled: "false"     (no missing-issue alert)
#   AGENTGATEWAY_News__WatchdogTime: "07:30"  and  AGENTGATEWAY_News__WatchdogTimeZone: "Europe/Kyiv"
# The editorial gate defaults to 5-40 items with no mandatory category; AGENTGATEWAY_News__MinItems: "35"
# and AGENTGATEWAY_News__MinPerCategory: "1" restore the old, stricter gate.

# Advanced settings may be added to Compose explicitly as AGENTGATEWAY_<Section>__<Property>
# (for example AGENTGATEWAY_News__MinItems). The old TELEGRAMGATEWAY_ prefix still works; the new one wins.
# They are not passed through automatically from this file. See the configuration table in README.
