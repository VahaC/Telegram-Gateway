# Copy to .env and protect it (chmod 600). Never commit .env.

# REQUIRED: obtain a bot token from BotFather. Never paste it into logs or URLs in tickets.
# Use the raw BotFather token, without a URL or an extra "bot" prefix.
TELEGRAM_BOT_TOKEN=
# REQUIRED: a positive private chat ID. The client cannot override this destination.
TELEGRAM_CHAT_ID=
# REQUIRED: generate with openssl rand -hex 32. Every writer shares this single-user credential.
API_KEY=

# OPTIONAL: the exact public DNS name used by your reverse proxy; wildcard hosts are rejected.
GATEWAY_HOST=gateway.example.invalid
# OPTIONAL: proxy's literal IP, only when forwarded client IP/protocol headers are needed.
# Blank keeps forwarded headers disabled. Never trust a public client IP or broad network.
TRUSTED_PROXY_IP=
# OPTIONAL: network name to share with Nginx Proxy Manager or cloudflared.
GATEWAY_NETWORK=telegram-gateway
# OPTIONAL: enables /mcp for clients that can provide X-Api-Key. It does not enable ChatGPT OAuth.
# Enabled MCP includes read-only delivery status queries by UUID for messages and digests.
ENABLE_MCP=false
ENABLE_MCP_OAUTH=false
MCP_PUBLIC_URL=https://gateway.example.invalid
MCP_OAUTH_CLIENT_ID=telegram-gateway
# Generate a separate 32+ character client secret; never commit the real value.
OAUTH_CLIENT_SECRET=
# Copy the exact HTTPS callback URI shown by your MCP client; wildcards are not accepted.
MCP_OAUTH_REDIRECT_URI=
# OPTIONAL: per connection IP; trusted proxy configuration is required for distinct external clients.
REQUEST_LIMIT_PER_MINUTE=30

# Advanced settings may be added to Compose explicitly as TELEGRAMGATEWAY_Gateway__<Property>.
# They are not passed through automatically from this file. See the configuration table in README.
